unset bazarr_settings indexer_list prowlarr_api_key
n=$(docker exec qbittorrent-exporter /usr/bin/wget -qO- http://127.0.0.1:8090/metrics | grep -c '^qbittorrent_' || true)
[ "$n" -gt 0 ] && printf 'qbittorrent-exporter: %s qbittorrent_* metrics\n' "$n" ||
  printf 'qbittorrent-exporter: no qbittorrent_* metrics yet (check its log for a login failure)\n' >&2
m=$(docker exec scraparr /usr/bin/wget -qO- http://127.0.0.1:7100/metrics | grep -c -E '^(sonarr|radarr|prowlarr|bazarr)_' || true)
[ "$m" -gt 0 ] && printf 'scraparr: %s *arr metrics\n' "$m" ||
  printf 'scraparr: no *arr metrics yet (check its log)\n' >&2
docker logs unpackerr 2>&1 | grep -i -E 'sonarr|radarr' | tail -2 | sed 's/^/unpackerr: /'
if [ "$torarr_state" = healthy ]; then
  printf 'torarr /ready: HTTP %s\n' "$(docker exec torarr /usr/bin/wget -q -O /dev/null -S http://127.0.0.1:9091/ready 2>&1 | sed -n 's/.*HTTP\/[0-9.]* \([0-9]*\).*/\1/p' | tail -1)"
else
  printf 'torarr: %s (re-run once it is healthy to add the Prowlarr proxy)\n' "$torarr_state"
fi
printf '\nwire-torrent-apps: done. Re-run at any time; it changes nothing that already exists.\n'
