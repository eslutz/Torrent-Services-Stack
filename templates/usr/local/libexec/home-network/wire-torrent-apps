wait_healthy() {
  for container in "$@"; do
    tries=0
    until [ "$(docker inspect -f '{{.State.Health.Status}}' "$container" 2>/dev/null || echo absent)" = healthy ]; do
      tries=$((tries + 1)); [ "$tries" -le 60 ] || fail "$container did not become healthy"
      sleep 5
    done
    printf '%s: healthy\n' "$container"
  done
}

